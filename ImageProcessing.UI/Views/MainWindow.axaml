<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageProcessing.UI.ViewModels"
        x:Class="ImageProcessing.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Обробка зображень" Width="900" Height="700">

    <!-- Grid (Сітка) ділить наше вікно на 3 рядки: верхній (кнопка), середній (фото), нижній (текст) -->
    <Grid RowDefinitions="Auto, *, Auto" Margin="15">
        
       <!-- Рядок 0: Кнопки керування -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Content="Відкрити фото..." Click="OnOpenFileClicked" Padding="10,5" />
            <Button Content="Чорно-біле" Click="OnGrayscaleClicked" Padding="10,5" />
            <Button Content="Розмиття" Click="OnBlurClicked" Padding="10,5" />
            <Button Click="OnEdgeClicked" Content="Виділення меж" Padding="10,5"/>
        </StackPanel>

        <!-- Рядок 1: Рамка, всередині якої буде наша картинка -->
        <Border Grid.Row="1" Background="#222222" BorderBrush="#555555" BorderThickness="1">
            <!-- Тут магія: {Binding DisplayedImage} каже вікну автоматично брати картинку з нашого "мізка" -->
            <Image Source="{Binding DisplayedImage}" Stretch="Uniform" />
        </Border>

  <!-- Рядок 2: Статус, статистика та графік -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" />
            <TextBlock Text="{Binding ImageStats}" Foreground="LightBlue" FontWeight="Bold" Margin="0,5,0,0"/>
            
            <!-- Ось наше нове зображення гістограми -->
            <Image Source="{Binding HistogramImage}" Height="100" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
    
</Window>